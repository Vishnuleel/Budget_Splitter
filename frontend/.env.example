# Copy to .env and fill in. Never commit .env.
# Both values are public by design; Row Level Security protects the data (see supabase/SECURITY.md).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only (set in Cloudflare Pages / Vercel, or .dev.vars for `npm run cf:dev`)
# SUPABASE_SERVICE_ROLE_KEY=service-role-key
# GEMINI_API_KEY=your-gemini-key

# Set to 1 to always start with sample data
# VITE_DEMO=1
